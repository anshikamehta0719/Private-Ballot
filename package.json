{
  "name": "midnight-private-ballot",
  "version": "0.1.0",
  "description": "Anonymous ballots with publicly verifiable tallies, built on Midnight (Compact).",
  "private": true,
  "type": "module",
  "scripts": {
    "compact": "compactc contracts/private-ballot.compact managed/private-ballot",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "deploy": "tsx scripts/deploy.ts",
    "dust-probe": "tsx scripts/dust-probe.ts",
    "dev": "vite",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.3.0"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.8.0",
    "@midnight-ntwrk/midnight-js-contracts": "^1.0.0",
    "@midnight-ntwrk/midnight-js-network-id": "^1.0.0",
    "@midnight-ntwrk/wallet": "^4.0.0",
    "dotenv": "^16.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@midnight-ntwrk/dapp-connector-api": "^1.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}