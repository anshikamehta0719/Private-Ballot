{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "declaration": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src",
    "witnesses"
  ],
  "exclude": [
    "node_modules",
    "managed",
    "dist"
  ]
}