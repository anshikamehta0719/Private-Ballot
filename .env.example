# Which testnet to target: preview or preprod
MIDNIGHT_NETWORK=preprod

# Local proof server (started via `docker-compose up -d proof-server`)
PROOF_SERVER_URL=http://localhost:6300

# Indexer / node endpoints for the chosen network. Fill these in from
# https://docs.midnight.network/relnotes/environment-endpoints or your own
# node setup.
MIDNIGHT_PREPROD_INDEXER=
MIDNIGHT_PREPROD_NODE=
MIDNIGHT_PREVIEW_INDEXER=
MIDNIGHT_PREVIEW_NODE=

# Wallet used to deploy + pay fees. Provide ONE of the following two for the
# network you are deploying to. Fund it first via the preprod/preview
# faucet. Never commit real values -- this file is gitignored once renamed
# to .env or .env.<network>.
# MIDNIGHT_PREPROD_MNEMONIC=word1 word2 word3 ...
# MIDNIGHT_PREPROD_SEED=64_hex_characters
# MIDNIGHT_PREVIEW_MNEMONIC=word1 word2 word3 ...
# MIDNIGHT_PREVIEW_SEED=64_hex_characters

# Admin secret used to derive the on-chain `admin` commitment at deploy
# time. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BALLOT_ADMIN_SECRET_HEX=
